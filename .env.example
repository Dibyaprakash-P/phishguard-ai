# ===========================================================================
# PhishGuard AI — environment configuration
#
# Copy to `.env` and fill in as needed:   cp .env.example .env
#
# The application runs fully WITHOUT any of these set. With no LLM
# credentials it serves the deterministic rule-based security analysis and
# labels it as such — the ML detection is unaffected.
#
# NEVER commit a real .env file. It is git-ignored.
# ===========================================================================

# --- Application -----------------------------------------------------------
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO

# Comma-separated list of allowed browser origins for CORS.
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# --- LLM provider ----------------------------------------------------------
# One of: openai | azure | none
# "none" disables the LLM entirely and always uses the rule-based explanation.
LLM_PROVIDER=none
LLM_ENABLED=true
LLM_TIMEOUT_SECONDS=20
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=400

# --- OpenAI (when LLM_PROVIDER=openai) ------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Optional: point at an OpenAI-compatible gateway.
OPENAI_BASE_URL=

# --- Azure OpenAI (when LLM_PROVIDER=azure) -------------------------------
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-08-01-preview

# --- Optional LangGraph agent ---------------------------------------------
# Exposes POST /api/agent-analyze. The core API does not depend on it.
ENABLE_AGENT=false

# --- Request limits --------------------------------------------------------
MAX_URL_LENGTH=2048
MAX_BATCH_SIZE=25

# --- Risk thresholds (product decisions, not universal constants) ----------
SUSPICIOUS_THRESHOLD=0.48
PHISHING_THRESHOLD=0.70
RISK_LOW_MAX=30
RISK_MEDIUM_MAX=70

# ===========================================================================
# Frontend (frontend/.env) — anything prefixed VITE_ is PUBLIC.
# Never put a secret here; it is embedded in the browser bundle.
# ===========================================================================
VITE_API_URL=http://localhost:8000
